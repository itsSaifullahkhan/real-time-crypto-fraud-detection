{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crypto-fraud-platform.local/device.schema.json",
  "title": "Device Master Data",
  "description": "Static device profile contract used to link authentication activity and customer transactions to observed customer devices.",
  "type": "object",
  "properties": {
    "device_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
    },
    "schema_version": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/schema_version"
    },
    "first_seen_at": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/utc_date_time"
    },
    "last_seen_at": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/utc_date_time"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "MOBILE",
        "DESKTOP",
        "TABLET"
      ]
    },
    "operating_system": {
      "type": "string",
      "enum": [
        "ANDROID",
        "IOS",
        "WINDOWS",
        "MACOS",
        "LINUX",
        "OTHER"
      ]
    },
    "is_trusted": {
      "type": "boolean"
    },
    "device_country": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/country_code"
    },
    "primary_account_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/nullable_uuid"
    }
  },
  "required": [
    "device_id",
    "schema_version",
    "first_seen_at",
    "last_seen_at",
    "device_type",
    "operating_system",
    "is_trusted",
    "device_country",
    "primary_account_id"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "device_id": "22222222-2222-4222-8222-222222222222",
      "schema_version": "1.0",
      "first_seen_at": "2026-01-01T00:05:00Z",
      "last_seen_at": "2026-01-15T09:00:00Z",
      "device_type": "MOBILE",
      "operating_system": "IOS",
      "is_trusted": true,
      "device_country": "US",
      "primary_account_id": "11111111-1111-4111-8111-111111111111"
    }
  ]
}
