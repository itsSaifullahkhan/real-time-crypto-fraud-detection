{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crypto-fraud-platform.local/authentication-event.schema.json",
  "title": "Authentication Event",
  "description": "Authentication attempt event contract for historical and live customer login activity.",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
    },
    "event_type": {
      "type": "string",
      "const": "authentication_event"
    },
    "schema_version": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/schema_version"
    },
    "source": {
      "type": "string",
      "enum": [
        "authentication_generator"
      ]
    },
    "event_timestamp": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/utc_date_time"
    },
    "source_timestamp": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/utc_date_time"
    },
    "ingestion_timestamp": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/utc_date_time"
    },
    "login_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
    },
    "account_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
    },
    "device_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
    },
    "country": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/country_code"
    },
    "ip_address": {
      "type": "string",
      "anyOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "login_success": {
      "type": "boolean"
    },
    "mfa_success": {
      "type": "boolean"
    },
    "password_reset_flag": {
      "type": "boolean"
    },
    "failure_reason": {
      "enum": [
        "INVALID_PASSWORD",
        "MFA_FAILED",
        "ACCOUNT_LOCKED",
        "DEVICE_BLOCKED",
        "OTHER",
        null
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "event_timestamp",
    "source_timestamp",
    "ingestion_timestamp",
    "login_id",
    "account_id",
    "device_id",
    "country",
    "ip_address",
    "login_success",
    "mfa_success",
    "password_reset_flag",
    "failure_reason"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "event_id": "44444444-4444-4444-8444-444444444444",
      "event_type": "authentication_event",
      "schema_version": "1.0",
      "source": "authentication_generator",
      "event_timestamp": "2026-01-15T11:58:00Z",
      "source_timestamp": "2026-01-15T11:58:01Z",
      "ingestion_timestamp": "2026-01-15T11:58:02Z",
      "login_id": "55555555-5555-4555-8555-555555555555",
      "account_id": "11111111-1111-4111-8111-111111111111",
      "device_id": "22222222-2222-4222-8222-222222222222",
      "country": "US",
      "ip_address": "203.0.113.10",
      "login_success": true,
      "mfa_success": true,
      "password_reset_flag": false,
      "failure_reason": null
    }
  ]
}
