{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crypto-fraud-platform.local/account.schema.json",
  "title": "Account Master Data",
  "description": "Static account profile contract used by historical generators, live generators, feature processing, and downstream Databricks tables.",
  "type": "object",
  "properties": {
    "account_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
    },
    "schema_version": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/schema_version"
    },
    "created_at": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/utc_date_time"
    },
    "updated_at": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/utc_date_time"
    },
    "home_country": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/country_code"
    },
    "kyc_level": {
      "type": "string",
      "enum": [
        "BASIC",
        "STANDARD",
        "ENHANCED"
      ]
    },
    "customer_risk_tier": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "normal_transaction_amount_usd": {
      "type": "number",
      "minimum": 0
    },
    "normal_transaction_frequency_per_day": {
      "type": "number",
      "minimum": 0
    },
    "preferred_assets": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/asset_symbol"
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "account_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "CLOSED"
      ]
    }
  },
  "required": [
    "account_id",
    "schema_version",
    "created_at",
    "updated_at",
    "home_country",
    "kyc_level",
    "customer_risk_tier",
    "normal_transaction_amount_usd",
    "normal_transaction_frequency_per_day",
    "preferred_assets",
    "account_status"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "account_id": "11111111-1111-4111-8111-111111111111",
      "schema_version": "1.0",
      "created_at": "2026-01-01T00:00:00Z",
      "updated_at": "2026-01-10T00:00:00Z",
      "home_country": "US",
      "kyc_level": "STANDARD",
      "customer_risk_tier": "LOW",
      "normal_transaction_amount_usd": 250.0,
      "normal_transaction_frequency_per_day": 2.0,
      "preferred_assets": [
        "BTC",
        "ETH"
      ],
      "account_status": "ACTIVE"
    }
  ]
}
