{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crypto-fraud-platform.local/customer-transaction.schema.json",
  "title": "Customer Transaction Event",
  "description": "Customer deposit, withdrawal, and transfer event contract. Fraud labels are intentionally excluded to prevent target leakage.",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
    },
    "event_type": {
      "type": "string",
      "const": "customer_transaction"
    },
    "schema_version": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/schema_version"
    },
    "source": {
      "type": "string",
      "enum": [
        "historical_customer_generator",
        "realtime_customer_generator"
      ]
    },
    "event_timestamp": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/utc_date_time"
    },
    "source_timestamp": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/utc_date_time"
    },
    "ingestion_timestamp": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/utc_date_time"
    },
    "transaction_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
    },
    "account_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
    },
    "asset": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/asset_symbol"
    },
    "crypto_quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "DEPOSIT",
        "WITHDRAWAL",
        "TRANSFER"
      ]
    },
    "source_wallet_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/nullable_uuid"
    },
    "destination_wallet_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/nullable_uuid"
    },
    "device_id": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
    },
    "country": {
      "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/country_code"
    },
    "market_price_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "transaction_amount_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "transaction_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED",
        "FAILED"
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "event_timestamp",
    "source_timestamp",
    "ingestion_timestamp",
    "transaction_id",
    "account_id",
    "asset",
    "crypto_quantity",
    "transaction_type",
    "source_wallet_id",
    "destination_wallet_id",
    "device_id",
    "country",
    "market_price_usd",
    "transaction_amount_usd",
    "transaction_status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "is_fraud"
            ]
          },
          {
            "required": [
              "fraud_type"
            ]
          },
          {
            "required": [
              "fraud_label"
            ]
          },
          {
            "required": [
              "confirmed_fraud"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transaction_type": {
            "const": "DEPOSIT"
          }
        },
        "required": [
          "transaction_type"
        ]
      },
      "then": {
        "properties": {
          "destination_wallet_id": {
            "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transaction_type": {
            "const": "WITHDRAWAL"
          }
        },
        "required": [
          "transaction_type"
        ]
      },
      "then": {
        "properties": {
          "source_wallet_id": {
            "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
          },
          "destination_wallet_id": {
            "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transaction_type": {
            "const": "TRANSFER"
          }
        },
        "required": [
          "transaction_type"
        ]
      },
      "then": {
        "properties": {
          "source_wallet_id": {
            "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
          },
          "destination_wallet_id": {
            "$ref": "https://schemas.crypto-fraud-platform.local/common-event.schema.json#/$defs/uuid"
          }
        }
      }
    }
  ],
  "examples": [
    {
      "event_id": "66666666-6666-4666-8666-666666666666",
      "event_type": "customer_transaction",
      "schema_version": "1.0",
      "source": "historical_customer_generator",
      "event_timestamp": "2026-01-15T12:00:00Z",
      "source_timestamp": "2026-01-15T12:00:01Z",
      "ingestion_timestamp": "2026-01-15T12:00:02Z",
      "transaction_id": "77777777-7777-4777-8777-777777777777",
      "account_id": "11111111-1111-4111-8111-111111111111",
      "asset": "BTC",
      "crypto_quantity": 0.005,
      "transaction_type": "WITHDRAWAL",
      "source_wallet_id": "33333333-3333-4333-8333-333333333333",
      "destination_wallet_id": "88888888-8888-4888-8888-888888888888",
      "device_id": "22222222-2222-4222-8222-222222222222",
      "country": "US",
      "market_price_usd": 40000.0,
      "transaction_amount_usd": 200.0,
      "transaction_status": "COMPLETED"
    }
  ]
}
