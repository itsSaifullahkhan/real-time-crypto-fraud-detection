{
  "name": "crypto-fraud-live-demo",
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "timeout_seconds": 1800,
  "queue": {
    "enabled": true
  },
  "parameters": [
    {
      "name": "demo_duration_seconds",
      "default": "300"
    },
    {
      "name": "target_transactions",
      "default": "25"
    },
    {
      "name": "fraud_rate",
      "default": "0.10"
    },
    {
      "name": "refresh_feedback",
      "default": "true"
    },
    {
      "name": "refresh_gold",
      "default": "true"
    },
    {
      "name": "enable_alerting",
      "default": "true"
    },
    {
      "name": "send_test_alert",
      "default": "true"
    },
    {
      "name": "producer_start_delay_seconds",
      "default": "45"
    },
    {
      "name": "live_timeout_seconds",
      "default": "420"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "demo_realtime_job_compute",
      "new_cluster": {
        "spark_version": "18.x-scala2.13",
        "node_type_id": "Standard_D4ds_v5",
        "num_workers": 0,
        "runtime_engine": "STANDARD",
        "data_security_mode": "USER_ISOLATION",
        "enable_elastic_disk": true,
        "azure_attributes": {
          "availability": "ON_DEMAND_AZURE",
          "first_on_demand": 1,
          "spot_bid_max_price": -1
        },
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*, 4]",
          "spark.databricks.streaming.realTimeMode.enabled": "true"
        },
        "custom_tags": {
          "Project": "crypto-fraud-platform",
          "Purpose": "live-demo",
          "ResourceClass": "SingleNode"
        }
      }
    },
    {
      "job_cluster_key": "demo_storage_job_compute",
      "new_cluster": {
        "spark_version": "18.x-scala2.13",
        "node_type_id": "Standard_D4ds_v5",
        "num_workers": 0,
        "runtime_engine": "STANDARD",
        "data_security_mode": "USER_ISOLATION",
        "enable_elastic_disk": true,
        "azure_attributes": {
          "availability": "ON_DEMAND_AZURE",
          "first_on_demand": 1,
          "spot_bid_max_price": -1
        },
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*, 4]"
        },
        "custom_tags": {
          "Project": "crypto-fraud-platform",
          "Purpose": "live-demo-storage",
          "ResourceClass": "SingleNode"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "prepare_demo",
      "job_cluster_key": "demo_realtime_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/14_demo_prepare",
        "source": "WORKSPACE",
        "base_parameters": {
          "demo_duration_seconds": "{{job.parameters.demo_duration_seconds}}",
          "target_transactions": "{{job.parameters.target_transactions}}",
          "fraud_rate": "{{job.parameters.fraud_rate}}",
          "enable_alerting": "{{job.parameters.enable_alerting}}",
          "send_test_alert": "{{job.parameters.send_test_alert}}"
        }
      },
      "timeout_seconds": 900
    },
    {
      "task_key": "storage_compute_ready",
      "job_cluster_key": "demo_storage_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/15_demo_wait_for_live_completion",
        "source": "WORKSPACE",
        "base_parameters": {
          "label_settle_seconds": "0"
        }
      },
      "timeout_seconds": 900
    },
    {
      "task_key": "market_producer",
      "depends_on": [
        {
          "task_key": "prepare_demo"
        }
      ],
      "job_cluster_key": "demo_realtime_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/11_demo_market_producer",
        "source": "WORKSPACE",
        "base_parameters": {
          "demo_duration_seconds": "{{job.parameters.demo_duration_seconds}}",
          "producer_start_delay_seconds": "{{job.parameters.producer_start_delay_seconds}}",
          "validate_schema": "true"
        }
      },
      "timeout_seconds": 700
    },
    {
      "task_key": "customer_generator",
      "depends_on": [
        {
          "task_key": "prepare_demo"
        }
      ],
      "job_cluster_key": "demo_realtime_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/12_demo_customer_generator",
        "source": "WORKSPACE",
        "base_parameters": {
          "demo_duration_seconds": "{{job.parameters.demo_duration_seconds}}",
          "target_transactions": "{{job.parameters.target_transactions}}",
          "fraud_rate": "{{job.parameters.fraud_rate}}",
          "producer_start_delay_seconds": "{{job.parameters.producer_start_delay_seconds}}",
          "label_delay_seconds": "10",
          "force_fraud_count": "1",
          "validate_schema": "true"
        }
      },
      "timeout_seconds": 750
    },
    {
      "task_key": "realtime_scoring",
      "depends_on": [
        {
          "task_key": "prepare_demo"
        }
      ],
      "job_cluster_key": "demo_realtime_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/06_realtime_fraud_scoring",
        "source": "WORKSPACE",
        "base_parameters": {
          "target_sample_transactions": "{{job.parameters.target_transactions}}",
          "timeout_seconds": "{{job.parameters.live_timeout_seconds}}",
          "real_time_trigger": "5 seconds"
        }
      },
      "timeout_seconds": 750
    },
    {
      "task_key": "live_storage",
      "depends_on": [
        {
          "task_key": "prepare_demo"
        },
        {
          "task_key": "storage_compute_ready"
        }
      ],
      "job_cluster_key": "demo_storage_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/07_live_bronze_storage",
        "source": "WORKSPACE",
        "base_parameters": {
          "trigger_mode": "processingTime",
          "starting_offsets": "latest",
          "run_resume_check": "false",
          "timeout_seconds": "{{job.parameters.live_timeout_seconds}}",
          "processing_time_trigger": "10 seconds"
        }
      },
      "timeout_seconds": 750
    },
    {
      "task_key": "alert_monitor",
      "depends_on": [
        {
          "task_key": "prepare_demo"
        }
      ],
      "job_cluster_key": "demo_realtime_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/13_demo_alert_monitor",
        "source": "WORKSPACE",
        "base_parameters": {
          "enable_alerting": "{{job.parameters.enable_alerting}}",
          "send_test_alert": "{{job.parameters.send_test_alert}}",
          "timeout_seconds": "{{job.parameters.live_timeout_seconds}}",
          "real_time_trigger": "5 seconds"
        }
      },
      "timeout_seconds": 750
    },
    {
      "task_key": "wait_for_live_completion",
      "depends_on": [
        {
          "task_key": "live_storage"
        },
        {
          "task_key": "alert_monitor"
        }
      ],
      "job_cluster_key": "demo_realtime_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/15_demo_wait_for_live_completion",
        "source": "WORKSPACE",
        "base_parameters": {
          "label_settle_seconds": "15"
        }
      },
      "timeout_seconds": 120
    },
    {
      "task_key": "feedback_refresh",
      "depends_on": [
        {
          "task_key": "wait_for_live_completion"
        }
      ],
      "job_cluster_key": "demo_realtime_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/09_feedback_retraining",
        "source": "WORKSPACE",
        "base_parameters": {
          "run_retraining": "false"
        }
      },
      "timeout_seconds": 900
    },
    {
      "task_key": "gold_refresh",
      "depends_on": [
        {
          "task_key": "feedback_refresh"
        }
      ],
      "job_cluster_key": "demo_realtime_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/10_gold_analytics",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "demo_summary",
      "depends_on": [
        {
          "task_key": "gold_refresh"
        }
      ],
      "job_cluster_key": "demo_realtime_job_compute",
      "notebook_task": {
        "notebook_path": "/Users/akanaskhan1506@gmail.com/16_demo_summary",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 900
    }
  ]
}
